# These override src/deployments.json (written by the deploy script).
# Set them if you prefer env-based config or are deploying to Vercel.

# Deployed StableSettleEscrow address
VITE_ESCROW_ADDRESS=

# Settlement token address (MockUSDC, or Arc USDC 0x3600...0000)
VITE_USDC_ADDRESS=

# Optional: block the escrow was deployed at — speeds up event scanning.
# VITE_DEPLOY_BLOCK=

# Optional: pre-fill the Agent Vaults page with a vault address (from arc:spawn-agent).
# VITE_AGENT_VAULT_ADDRESS=

# Optional: block an AgentVault was deployed at — widens the Spent-history scan beyond
# the default last ~9k blocks (Arc's eth_getLogs cap).
# VITE_VAULT_FROM_BLOCK=

# Optional: point at the Hono API to read orders/audit log from the indexer + Postgres
# instead of directly from chain. Leave unset to read events directly (no backend needed).
# VITE_API_URL=http://localhost:8787

# Optional: pin a single Arc RPC provider. Unset → fallback across all official endpoints
# (Circle, dRPC, QuickNode, Blockdaemon). See docs.arc.network/references/rpc-endpoints.
# VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
