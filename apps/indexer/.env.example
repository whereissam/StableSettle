# Same Postgres as the API
DATABASE_URL=postgres://stablesettle:stablesettle@localhost:5433/stablesettle

# Arc testnet RPC (official endpoints: docs.arc.network/references/rpc-endpoints)
#   Circle (primary): https://rpc.testnet.arc.network
#   dRPC:             https://rpc.drpc.testnet.arc.network
#   QuickNode:        https://rpc.quicknode.testnet.arc.network
#   Blockdaemon:      https://rpc.blockdaemon.testnet.arc.network
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Deployed escrow address. If unset, falls back to apps/web/src/deployments.json.
ESCROW_ADDRESS=

# Block the escrow was deployed at — where the first scan starts (default 0).
DEPLOY_BLOCK=0

# Poll interval (ms)
POLL_INTERVAL_MS=4000
