# ── Arc testnet ──────────────────────────────────────────────────────────────
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# Arc testnet chain id (override if it differs for your endpoint).
ARC_CHAIN_ID=

# The human owner / deployer. This key deploys vaults and is granted HUMAN_OWNER_ROLE.
# On Arc, USDC is the gas token — fund this address at https://faucet.circle.com.
DEPLOYER_PRIVATE_KEY=0x...

# Settlement token. Arc native USDC is 0x3600000000000000000000000000000000000000.
# Leave unset to require it explicitly per spawn.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Circle Developer-Controlled Wallets (the agent's isolated wallet) ─────────
# Format: PREFIX:ID:SECRET — see https://developers.circle.com
CIRCLE_API_KEY=
# 32-byte hex entity secret. Generate + register once (NEVER commit it):
#   https://developers.circle.com/wallets/dev-controlled/register-entity-secret
ENTITY_SECRET=
# Circle blockchain identifier for Arc testnet (e.g. ARC-TESTNET). Check the Circle docs.
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Optional: reuse an existing wallet set instead of creating one per process.
CIRCLE_WALLET_SET_ID=

# ── ENS (agent identity) via NameStone gasless subnames ──────────────────────
# Parent name under which agent subnames are issued, e.g. stablesettle.eth
ENS_PARENT_NAME=stablesettle.eth
# NameStone API key (get one at https://namestone.com/try-namestone). If unset, the ENS name is
# still reserved/returned but no subname is issued (spawn still works).
NAMESTONE_API_KEY=
# Which ENS network NameStone serves the parent on: sepolia (default) or mainnet.
NAMESTONE_NETWORK=sepolia
# One-time setup: point ENS_PARENT_NAME's resolver at NameStone's offchain resolver, and enable the
# domain in NameStone, before subnames will resolve. See README → ENS setup.

# ── World ID (human-backed agents) ───────────────────────────────────────────
# Create an app + incognito action at https://developer.worldcoin.org and use the STAGING app id
# (app_staging_…) so you can verify with the simulator (https://simulator.worldcoin.org) — no Orb needed.
# If unset, spawn still works but the agent is recorded as not-yet-verified (zero nullifier).
WORLD_ID_APP_ID=
WORLD_ID_ACTION=authorize-agent

# ── x402 nanopayments (the demo seller) ──────────────────────────────────────
# Only needed to run `bun run x402:seller` — the agent buyer (agent_pay_x402) needs no extra config.
# The address that receives x402 payments (the seller's payout address).
X402_SELLER_ADDRESS=
# Price per request in USDC dollars (default 0.01).
X402_PRICE_USDC=0.01
# Port the seller listens on (default 4021).
X402_PORT=4021

# ── Hosted HTTP mode (optional — serve over a URL instead of stdio) ──────────
# Set to "http" to serve Streamable HTTP so users connect with a URL and run nothing locally.
# Leave empty for the default stdio mode (local dev / .mcp.json).
MCP_TRANSPORT=
# Port to listen on (default 8080; many hosts inject PORT, which is also honored).
MCP_HTTP_PORT=
# REQUIRED before exposing to the internet — this process holds the deployer + Circle keys.
# Clients must send `Authorization: Bearer <this>`. Generate a long random value, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=

# ── Persistence ──────────────────────────────────────────────────────────────
# Where the registry of spawned agents is stored (JSON). Defaults to ./.agents.json
AGENT_STORE_PATH=
