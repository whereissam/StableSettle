# Arc testnet RPC (USDC is the native gas token on Arc)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Settlement token.
#   - Leave UNSET to deploy a self-contained MockUSDC (public mint) for the demo.
#   - Set to Arc's native USDC to settle in real testnet USDC:
# USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Deployer key — for LOCAL testing only. For testnet, import an encrypted keystore
# instead (cast wallet import deployer) and deploy with --account deployer.
# PRIVATE_KEY=
